
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users | CloudDemo</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <h2>CloudDemo</h2>
        <div>
            <a href="/">Home</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/user">Users</a>
        </div>
    </nav>

    <main class="container">

        <h1>User Directory</h1>
        <p>List of users loaded dynamically from data.json</p>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>City</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (users.length > 0) { %>

                        <% users.forEach((user) => { %>
                            <tr>
                                <td><%= user.id %></td>
                                <td><%= user.name %></td>
                                <td><%= user.username %></td>
                                <td><%= user.email %></td>
                                <td><%= user.city %></td>
                            </tr>
                        <% }) %>

                    <% } else { %>

                        <tr>
                            <td colspan="5">No users found.</td>
                        </tr>

                    <% } %>
                </tbody>
            </table>
        </div>

        <p class="user-count">
            Total Records: <strong><%= totalRecords %></strong>
        </p>

        <p>
            Page <strong><%= currentPage %></strong>
            of <strong><%= totalPages %></strong>
        </p>

        <!-- Pagination -->
        <div class="pagination">

            <% if (currentPage > 1) { %>
                <a href="/user?page=<%= currentPage - 1 %>">
                    Previous
                </a>
            <% } %>

            <% for (let i = 1; i <= totalPages; i++) { %>

                <a href="/user?page=<%= i %>"
                   class="<%= currentPage === i ? 'active' : '' %>">
                    <%= i %>
                </a>

            <% } %>

            <% if (currentPage < totalPages) { %>
                <a href="/user?page=<%= currentPage + 1 %>">
                    Next
                </a>
            <% } %>

        </div>

    </main>

    <footer>
        <p>CloudDemo | Learning Cloud & DevOps</p>
    </footer>

</body>
</html>
